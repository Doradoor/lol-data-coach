# Copia este archivo como .env y completa tus claves. Nunca subas .env a git.

# https://developer.riotgames.com
RIOT_API_KEY=
# https://aistudio.google.com/apikey (solo para la pestaña Coach)
GEMINI_API_KEY=

# 1 = muestra el modo "Mi cuenta", que guarda partidas en data/lol.db.
# Déjalo vacío en la app pública.
LOLCOACH_OWNER_MODE=

# Preguntas al coach por sesión en la app pública.
COACH_MAX_QUESTIONS=10
